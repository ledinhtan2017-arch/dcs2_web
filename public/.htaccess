# -------------------------------------------------------------------
# Sport Shop – Apache Rewrite Rules
# -------------------------------------------------------------------

# Deny access to sensitive files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|sh|bak|md|gitignore)$">
    Require all denied
</FilesMatch>

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Base path
    RewriteBase /

    # Block direct access to .env files anywhere
    RewriteRule (^|/)\.env - [F,L]

    # Disable PHP execution inside uploads directory
    RewriteRule ^uploads/.*\.php$ - [F,L]

    # If the request is for an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to the front controller
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
